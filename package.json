{
  "name": "wheatstone-bridge-pat1",
  "version": "2.0.0",
  "description": "Wheatstone Bridge PAT 1 Teaching Tool · Electrical Principles & Practice L4 · Orbit TVET College · MANKWE Campus",
  "main": "main.js",
  "author": {
    "name": "MJ MAAKE",
    "email": "manoke@hotmail.co.za"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/Manofork/wheatstone-bridge-pat1#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manofork/wheatstone-bridge-pat1.git"
  },
  "bugs": {
    "url": "https://github.com/Manofork/wheatstone-bridge-pat1/issues"
  },
  "keywords": [
    "wheatstone-bridge",
    "electrical-engineering",
    "electron",
    "tvet",
    "education",
    "calculator"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "lint": "node --check main.js && node --check preload.js && node scripts/check-renderer.js",
    "screenshot": "electron scripts/screenshot.js",
    "dist": "electron-builder --win --x64 --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win32": "electron-builder --win --ia32 --publish never"
  },
  "build": {
    "appId": "za.co.orbit.mankwe.wheatstone-bridge",
    "productName": "Wheatstone Bridge PAT1",
    "copyright": "MJ MAAKE · Orbit TVET College · MANKWE Campus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wheatstone Bridge PAT1",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Wheatstone-Bridge-PAT1-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Wheatstone-Bridge-PAT1-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
